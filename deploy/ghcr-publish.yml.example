# Publikasi image otomatis ke GitHub Container Registry (ghcr.io).
#
# CARA PAKAI:
#   1. copy file ini jadi .github/workflows/publish.yml lalu commit + push
#      (butuh token git dengan scope `workflow`; kalau tidak, GitHub menolak
#       push yang menambah/mengubah .github/workflows/).
#   2. jalankan: Actions -> publish -> Run workflow, atau cukup push tag:
#         git tag 1.0.0 && git push origin 1.0.0
#   3. setelah jadi, siapa pun bisa:
#         docker pull ghcr.io/<pemilik>/mailbot:1.0.0
#      dan di docker-compose.yml ganti `build: .` jadi `image: ghcr.io/<pemilik>/mailbot:1.0.0`
#
# Image TIDAK memuat rahasia apa pun: konfigurasi datang saat runtime dari .env
# (lihat .dockerignore — .env, state, dan log tidak pernah masuk image).
#
# Untuk Docker Hub, sama saja: ganti `registry:` + `images:` jadi
#   images: docker.io/<user>/mailbot
# dan set secret DOCKERHUB_USERNAME / DOCKERHUB_TOKEN.

name: publish

on:
  push:
    branches: [main]
    tags: ['*']
  workflow_dispatch:

env:
  REGISTRY: ghcr.io

jobs:
  image:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    steps:
      - uses: actions/checkout@v4

      - name: Siapkan buildx
        uses: docker/setup-buildx-action@v3

      - name: Login ke registry
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Nama image + tag
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.REGISTRY }}/${{ github.repository }}
          tags: |
            type=ref,event=branch
            type=semver,pattern={{version}}
            type=semver,pattern={{major}}.{{minor}}
            type=raw,value=latest,enable={{is_default_branch}}

      - name: Build & push
        uses: docker/build-push-action@v6
        with:
          context: .
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
