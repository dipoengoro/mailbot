# ============================================================================
# mailbot — contoh konfigurasi.  SALIN jadi .env lalu isi nilainya.
#   cp .env.example .env && chmod 600 .env
# .env TIDAK boleh masuk git (sudah ada di .gitignore).
# ============================================================================

# --- 1. Telegram ------------------------------------------------------------
# Token bot dari @BotFather.  Bot WAJIB privacy OFF (/setprivacy -> Disable)
# kalau notifikasinya dikirim ke grup, supaya bot bisa membaca pesan grup.
TELEGRAM_BOT_TOKEN=123456:ABC-isi-token-dari-botfather
# Chat tujuan notifikasi: id grup (negatif, mis. -1001234567890) atau id DM.
TELEGRAM_HOME_CHANNEL=1234567890
# Topik/thread di grup forum (kosongkan kalau bukan forum).
TELEGRAM_HOME_THREAD=
# Siapa yang boleh memerintah bot (user id Telegram, dipisah koma). Kosong = tidak ada.
TELEGRAM_ALLOWED_USERS=123456789

# --- 2. Akun email ----------------------------------------------------------
# Format: TAG:alamat@email  (TAG dipakai di nama var di bawah, huruf besar)
# Boleh lebih dari satu, dipisah koma. Akun yang env-nya belum lengkap dilewati.
MAILBOT_ACCOUNTS=MAIN:you@example.com,SECOND:you@gmail.com

# IMAP: pakai "app password"/kata sandi aplikasi, bukan kata sandi utama.
IMAP_MAIN_HOST=imap.example.com
IMAP_MAIN_USER=you@example.com
IMAP_MAIN_PASS=isi-app-password-disini
# SMTP: opsional. Kalau kosong, diturunkan dari host IMAP (imap.x -> smtp.x).
# SMTP_MAIN_HOST=smtp.example.com
# SMTP_MAIN_PORT=465
# IMAP_MAIN_PORT=993

IMAP_SECOND_HOST=imap.gmail.com
IMAP_SECOND_USER=you@gmail.com
IMAP_SECOND_PASS=isi-app-password-gmail

# --- 3. Halaman "Lihat" (render email jadi HTML) ----------------------------
# URL publik tempat file hasil render disajikan (dipakai untuk link di chat).
MAILBOT_VIEW_BASE=https://mail.example.com
# Folder di dalam container tempat file render ditulis (di-mount ke web server).
MAILBOT_VIEW_DIR=/view
# Panjang token acak di nama file (byte; 8 byte = 16 karakter hex). Link tanpa
# login, jadi jangan dikecilkan sampai gampang ditebak.
MAILBOT_VIEW_TOKEN_BYTES=8

# --- 4. Umum ----------------------------------------------------------------
# Zona waktu untuk jam di log & tanggal di kartu/kepala email.
MAILBOT_TZ_OFFSET=7
MAILBOT_TZ_LABEL=WIB
# Interval poller (detik).
MAILBOT_POLL_INTERVAL=180
# Folder yang dicari saat tombol aksi dipakai (uid itu unik PER folder).
MAILBOT_FOLDERS=INBOX,Newsletter,Notification,Spam,Archive,[Gmail]/Spam,[Gmail]/Penting
# Nama bot tanpa @ — dipakai memastikan balasan memang reply ke pesan bot.
MAILBOT_BOT_USERNAME=my_mail_bot
# Penanda di setiap pesan bot (biar kebedain dari bot lain di grup yang sama).
MAILBOT_FOOTER=📮 via @my_mail_bot

# --- 5. Opsional: fitur "🤖 Sempurnakan" (LLM) ------------------------------
# Kosongkan AI_KEY kalau tidak butuh; tombolnya akan menjawab bahwa fitur mati.
# AI_KEY=sk-isi-api-key
# AI_URL=https://api.deepseek.com/v1/chat/completions
# AI_MODEL=deepseek-chat
